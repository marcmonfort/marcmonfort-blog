---
// Component imports
import Main from "../layouts/MainLayout.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/controllers/Pagination.astro";
import Intro from "../components/Intro.astro";
import YukinaConfig from "../../yukina.config";
// Utils
import type { PaginateFunction } from "astro";
import { GetSortedPosts } from "../utils/content";

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction;
}) {
  const postCollections = await GetSortedPosts();
  // Show every project on the home page; pagination only kicks in past this.
  return paginate(postCollections, { pageSize: 50 });
}
const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;

// Structured data so search engines know who this site is about.
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: YukinaConfig.username,
  jobTitle: YukinaConfig.sign,
  url: YukinaConfig.site,
  image: new URL(YukinaConfig.ogImage, YukinaConfig.site).href,
  worksFor: {
    "@type": "CollegeOrUniversity",
    name: "Aalto University",
    url: "https://www.aalto.fi/en",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Universitat Politècnica de Catalunya",
    url: "https://www.upc.edu/en",
  },
  sameAs: [
    ...YukinaConfig.socialLinks.map((s) => s.link),
    "https://scholar.google.com/citations?user=EtRPHcQAAAAJ",
  ],
};
---

<Main pageTitle={isFirstPage ? undefined : `Projects – Page ${page.currentPage}`}>
  {
    isFirstPage && (
      <script
        is:inline
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(person)}
      />
    )
  }
  <div class="space-y-8">
    {
      isFirstPage && (
        <div
          class="onload-animation"
          style="animation-delay: var(--onload-animation-delay);"
        >
          <Intro />
        </div>
      )
    }
    <div class="w-full space-y-4">
      {
        isFirstPage && (
          <h2
            class="onload-animation section-title"
            style="animation-delay: calc(var(--onload-animation-delay) + var(--onload-animation-interval));"
          >
            Projects
          </h2>
        )
      }
      {
        page.data.map((entry, index) => (
          <div
            class="onload-animation"
            style={`animation-delay: calc(var(--onload-animation-delay) + ${index + 1} * var(--onload-animation-interval));`}
          >
            <PostCard
              id={entry.id}
              title={entry.data.title}
              published={entry.data.published}
              category={entry.data.category}
              tags={entry.data.tags}
              description={entry.data.description}
              image={entry.data.cover}
              coverPosition={entry.data.coverPosition}
            />
          </div>
        ))
      }
    </div>
    {
      page.lastPage > 1 && (
        <Pagination
          class="onload-animation"
          lastPage={page.lastPage}
          current={page.currentPage}
          prevURL={page.url.prev}
          nextURL={page.url.next}
          style={`animation-delay: calc(var(--onload-animation-delay) + ${page.data.length + 1} * var(--onload-animation-interval));`}
        />
      )
    }
  </div>
</Main>

<style>
  .section-title {
    @apply mx-3 border-l-4 border-[var(--primary-color)] pl-3 text-2xl font-bold text-[var(--text-color)] lg:mx-0;
    font-family: var(--brand-font);
  }
</style>
