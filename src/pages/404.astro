---
import Main from "../layouts/MainLayout.astro";
---

<Main
  title="Page not found"
  description="This page doesn't exist. It may have been moved or removed."
  hideBanner={true}
>
  <div class="not-found">
    <p class="code">404</p>
    <h1 class="heading">Page not found</h1>
    <p class="text">
      This page doesn't exist. It may have been moved or removed.
    </p>
    <div class="links">
      <a href="/" class="link link-primary">Home</a>
      <a href="/publications" class="link">Publications</a>
    </div>
  </div>
</Main>

<style>
  .not-found {
    @apply mx-3 flex flex-col items-center rounded-2xl bg-[var(--card-color)] px-6 py-16 text-center text-[var(--text-color)] lg:mx-0;
    font-family: var(--primary-font);
  }

  .code {
    @apply text-7xl font-bold text-[var(--primary-color)];
    font-family: var(--brand-font);
  }

  .heading {
    @apply mt-2 text-2xl font-bold;
    font-family: var(--brand-font);
  }

  .text {
    @apply mt-3 text-[var(--text-color-lighten)];
  }

  .links {
    @apply mt-8 flex flex-wrap justify-center gap-3;
  }

  .link {
    @apply rounded-lg bg-[var(--primary-color-lighten)] px-4 py-2 font-medium text-[var(--primary-color)] transition-all;
    @apply hover:bg-[var(--primary-color-hover)] active:scale-95;
  }

  .link-primary {
    @apply bg-[var(--primary-color)] text-white hover:bg-[var(--primary-color)] hover:brightness-110;
  }
</style>
