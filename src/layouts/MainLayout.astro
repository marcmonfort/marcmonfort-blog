---
import Base from "./BaseLayout.astro";
import NavBar from "../components/NavBar.astro";
import Banner from "../components/Banner.astro";

import YukinaConfig from "../../yukina.config";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";

export interface Props {
  title?: string;
  subTitle?: string;
  bannerImage?: string;
  coverPosition?: "top" | "center" | "bottom";
  slug?: string;
  hideBanner?: boolean;
  /** Title for the browser tab and search results. Defaults to `title`. */
  pageTitle?: string;
  /** Description for search results and link previews. Defaults to `subTitle`. */
  description?: string;
  /** Preview image for link previews. */
  ogImage?: string;
  ogType?: "website" | "article";
}

const props = Astro.props;
const head = {
  title: props.pageTitle ?? props.title,
  description: props.description ?? props.subTitle,
  image: props.ogImage,
  type: props.ogType,
};
---

<Base head={head}>
  <slot name="head" slot="head" />
  <NavBar />

  <div id="banner-container" class={props.hideBanner ? "mt-20" : ""}>
    {
      YukinaConfig.bannerStyle == "LOOP" && !props.hideBanner && (
        <Banner
          title={props.title}
          subTitle={props.subTitle}
          bannerImage={props.bannerImage}
          coverPosition={props.coverPosition}
          slug={props.slug}
        />
      )
    }
  </div>

  <div class="main-container my-10">
    <div class="flex flex-row items-start xl:space-x-4">
      <div class="side-bar">
        <SideBar />
      </div>
      <div class="transition-leaving w-full space-y-8">
        <main class="content onload-animation" id="main">
          <slot />
        </main>
        <Footer />
      </div>
    </div>
  </div>
</Base>

<style>
  .main-container {
    @apply w-full md:min-w-[80%] md:max-w-[80%] lg:min-w-[var(--page-width-lg)] lg:max-w-[var(--page-width-lg)] xl:min-w-[var(--page-width-xl)] xl:max-w-[var(--page-width-xl)];
    @apply md:mx-auto;
  }

  .side-bar {
    @apply hidden min-w-[248px] xl:block;
  }

  .content {
    @apply xl:w-[calc(var(--page-width-xl)-264px)];
  }
</style>
